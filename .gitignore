.DS_Store
node_modules/
dist/
build/
.venv/
__pycache__/
*.log

# Chopa Design : sorties générées du site (dist-lib/ reste versionné)
site/dist/
site/public/chopa/
.astro/

# Sorties des agents en parallèle (CH_OUT)
.out/
livraison/
