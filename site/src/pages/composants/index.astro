---
// /composants/ : la grille immobile des 63 pièces, en 5 familles (docs/ARCHITECTURE.md §16.3, décision M2).
// Même composant que la grille de l'accueil ; jamais de 3D. Cible du lien « Composants » et adresse stable de la version sans mouvement.
import DocLayout from '../../components/DocLayout.astro';
import Tuiles from '../../components/Tuiles.astro';
import { familles } from '../../immersif/donnees-mur.mjs';
const propres = familles.filter((f) => !f.propre);
const total = propres.reduce((n, f) => n + f.pieces.length, 0);
---
<DocLayout title="Composants" plein>
  <div class="im-grille-page">
  <h1 class="doc-h1 doc-h1--page">Composants</h1>
  <p class="doc-lead">{total} pièces en {propres.length} familles. Chaque pièce a sa page : à quoi elle sert, ses variantes montrées en direct avec leur code, ses états et ses points d'accessibilité.</p>
  {total === 0 && <p class="doc-text">Aucune pièce pour l'instant : chaque fiche ajoutée dans <code>site/src/data/</code> apparaît ici.</p>}
  <nav class="im-ancres" aria-label="Familles de pièces">
    <ol class="im-ancres__liste">
      {propres.map((f) => <li><a class="im-ancres__lien" href={`#famille-${f.ancre}`}><span class="im-ancres__num" aria-hidden="true">{f.num}</span> {f.nom}</a></li>)}
    </ol>
  </nav>
  <Tuiles />
  </div>
</DocLayout>
