{
  "slug": "dropdown",
  "cases": [
    {
      "id": "actions",
      "example": "dropdown/defaut",
      "js": true,
      "tabOrder": [
        ".ch-dropdown > .ch-btn"
      ],
      "steps": [
        {
          "key": "Enter"
        },
        {
          "wait": 150,
          "expect": {
            "focus": ".ch-dropdown__panel .ch-dropdown__item:nth-child(1)",
            "attr": {
              "sel": ".ch-dropdown > .ch-btn",
              "name": "aria-expanded",
              "value": "true"
            }
          }
        },
        {
          "key": "ArrowDown",
          "expect": {
            "focus": ".ch-dropdown__panel .ch-dropdown__item:nth-child(2)"
          }
        },
        {
          "key": "ArrowDown",
          "expect": {
            "focus": ".ch-dropdown__panel .ch-dropdown__item:nth-child(3)"
          }
        },
        {
          "key": "ArrowDown",
          "expect": {
            "focus": ".ch-dropdown__panel .ch-dropdown__item:nth-child(1)"
          }
        },
        {
