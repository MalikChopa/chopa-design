            "attr": {
              "sel": ".ch-dropdown > .ch-btn",
              "name": "aria-expanded",
              "value": "true"
            }
          }
        },
        {
          "key": "Tab"
        },
        {
          "wait": 150,
          "expect": {
            "attr": {
              "sel": ".ch-dropdown > .ch-btn",
              "name": "aria-expanded",
              "value": "false"
            }
