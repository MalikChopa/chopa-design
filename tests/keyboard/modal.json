{
  "slug": "modal",
  "cases": [
    {
      "id": "ouvrir-boucler-fermer",
      "example": "modal/defaut",
      "js": true,
      "tabOrder": [
        "[data-ch-dialog-open]"
      ],
      "steps": [
        {
          "key": "Enter",
          "expect": {
            "focus": ".ch-modal__foot .ch-btn--primary",
            "matches": {
              "sel": ".ch-modal",
              "query": ":modal",
              "value": true
            }
          }
        },
        {
          "key": "Tab",
          "expect": {
            "focus": ".ch-modal__close"
          }
        },
        {
          "key": "Tab",
          "expect": {
            "focus": ".ch-modal__foot .ch-btn--secondary"
          }
        },
        {
          "key": "Shift+Tab",
          "expect": {
            "focus": ".ch-modal__close"
          }
        },
        {
          "key": "Shift+Tab",
          "expect": {
            "focus": ".ch-modal__foot .ch-btn--primary"
          }
        },
        {
          "key": "Escape",
          "expect": {
            "focus": "[data-ch-dialog-open]",
            "matches": {
              "sel": ".ch-modal",
              "query": ":modal",
              "value": false
            }
          }
        }
      ]
    },
    {
